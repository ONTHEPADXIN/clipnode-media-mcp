{
  "version": 1,
  "schema": "clipnode.mcp.templates.v1",
  "description": "Built-in reference templates for ClipNode MCP clients. Templates are examples and must be merged with user intent, probed sources, and capabilities before validation.",
  "items": [
    {
      "id": "video_soft_9_16",
      "version": 1,
      "name": "Soft 9:16 Video",
      "description": "Crop a video to 9:16, keep audio, and export with quality-first settings.",
      "taskType": "video_edit",
      "tags": ["short_video", "portrait", "soft", "social"],
      "input": {
        "mediaTypes": ["video"],
        "minSources": 1,
        "maxSources": 1
      },
      "variables": [],
      "config": {
        "canvas": {
          "preset": "custom",
          "width": 1080,
          "height": 1920
        },
        "fit": {
          "mode": "center_crop"
        },
        "export": {
          "preset": "quality_first",
          "keepAudio": true
        }
      }
    },
    {
      "id": "video_full_self_blur_canvas",
      "version": 1,
      "name": "Full Video With Self Blur Background",
      "description": "Show the full foreground video on a custom canvas and fill the canvas with a blurred copy of the same video.",
      "taskType": "video_edit",
      "tags": ["video", "canvas", "background", "self_blur", "full_frame", "center_inside"],
      "input": {
        "mediaTypes": ["video"],
        "minSources": 1,
        "maxSources": 1
      },
      "variables": [
        {
          "name": "canvasWidth",
          "type": "number",
          "required": false,
          "default": 640
        },
        {
          "name": "canvasHeight",
          "type": "number",
          "required": false,
          "default": 480
        },
        {
          "name": "blurRadius",
          "type": "number",
          "required": false,
          "default": 24
        }
      ],
      "config": {
        "canvas": {
          "preset": "custom",
          "width": 640,
          "height": 480,
          "background": {
            "mode": "self_blur",
            "fitMode": "center_crop",
            "blurEnabled": true,
            "blurRadius": 24,
            "opacity": 1.0,
            "color": "#000000"
          }
        },
        "fit": {
          "mode": "center_inside"
        },
        "export": {
          "preset": "quality_first",
          "keepAudio": true
        }
      }
    },
    {
      "id": "video_compress_480p_size_first",
      "version": 1,
      "name": "480p Size-First Video Compress",
      "description": "Compress one video with size-first bitrate settings, 480p max output, and optional audio preservation.",
      "taskType": "video_compress",
      "tags": ["video", "compress", "size_first", "480p", "mp4"],
      "input": {
        "mediaTypes": ["video"],
        "minSources": 1,
        "maxSources": 1
      },
      "variables": [],
      "config": {
        "export": {
          "preset": "size_first",
          "bitrateFactor": 0.14,
          "targetHeight": 480,
          "fps": 24,
          "keepAudio": true
        }
      }
    },
    {
      "id": "video_composition_soft_fade",
      "version": 1,
      "name": "Soft Fade Video Composition",
      "description": "Compose multiple clips into one video with soft fade transitions and audio cross-fade.",
      "taskType": "video_composition",
      "tags": ["video_composition", "视频合成", "soft", "fade", "smooth"],
      "input": {
        "mediaTypes": ["video", "image"],
        "minSources": 2,
        "maxSources": 30
      },
      "variables": [],
      "config": {
        "transitionDefaults": {
          "assetPath": "transitions/fade.glsl",
          "durationUs": 800000,
          "audioCrossFade": true,
          "tags": ["soft", "fade", "smooth"]
        },
        "export": {
          "preset": "quality_first",
          "keepAudio": true
        }
      }
    },
    {
      "id": "hls_to_mp4_quality",
      "version": 1,
      "name": "HLS to MP4 Quality",
      "description": "Export one m3u8 URL to a final MP4 file with network fallback enabled.",
      "taskType": "hls_mp4_export",
      "tags": ["hls", "m3u8", "mp4", "quality"],
      "input": {
        "mediaTypes": ["m3u8"],
        "minSources": 1,
        "maxSources": 1
      },
      "variables": [
        {
          "name": "videoId",
          "type": "number",
          "required": true
        },
        {
          "name": "url",
          "type": "string",
          "required": true
        }
      ],
      "config": {
        "export": {
          "overwrite": false,
          "allowNetworkFallback": true,
          "cleanupSegments": true,
          "keepAudio": true
        }
      }
    },
    {
      "id": "gif_crop_resize_reverse",
      "version": 1,
      "name": "GIF Crop Resize Reverse",
      "description": "Crop a GIF with normalized coordinates, optionally sample frames, reverse frame order, and resize output.",
      "taskType": "gif_edit",
      "tags": ["gif", "crop", "resize", "reverse", "sampling"],
      "input": {
        "mediaTypes": ["gif"],
        "minSources": 1,
        "maxSources": 1
      },
      "variables": [],
      "config": {
        "gif": {
          "backward": true,
          "frameSpace": 1,
          "outputWidth": 320,
          "outputHeight": 320,
          "crop": {
            "enabled": true,
            "x": 0.1,
            "y": 0.1,
            "width": 0.8,
            "height": 0.8
          }
        },
        "export": {
          "outputName": "gif_crop_resize_reverse.gif"
        }
      }
    },
    {
      "id": "video_to_gif_clip_crop",
      "version": 1,
      "name": "Video to GIF Clip Crop",
      "description": "Convert a short video range to a resized GIF with optional frame sampling, reverse order, and normalized crop.",
      "taskType": "video_to_gif",
      "tags": ["video", "gif", "clip", "crop", "resize", "sampling"],
      "input": {
        "mediaTypes": ["video"],
        "minSources": 1,
        "maxSources": 1
      },
      "variables": [],
      "config": {
        "timeRange": {
          "startUs": 0,
          "endUs": 2000000
        },
        "gif": {
          "fps": 12,
          "frameSpace": 1,
          "backward": false,
          "outputWidth": 320,
          "outputHeight": 320,
          "crop": {
            "enabled": true,
            "x": 0.1,
            "y": 0.1,
            "width": 0.8,
            "height": 0.8
          }
        },
        "export": {
          "outputName": "video_to_gif_clip_crop.gif"
        }
      }
