              "scale": 0.42,
              "rotation": 0,
              "gif": {
                "path": "{{gifPath}}"
              },
              "grid": {
                "enabled": false,
                "rows": 1,
                "columns": 1
              },
              "timeBinding": {
                "moveWithTime": false
              },
              "animation": {
                "inName": "FadeHandler",
                "loopName": "",
                "outName": "FadeHandler"
              }
            }
          ]
        },
        "export": {
          "preset": "balanced",
          "quality": "balanced",
          "fps": 24,
          "keepAudio": false,
          "bitrateFactor": 0.5
