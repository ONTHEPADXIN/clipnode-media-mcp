                "columns": 2,
                "horizontalSpacing": 0.35,
                "verticalSpacing": 0.1
              },
              "timeBinding": {
                "moveWithTime": true
              },
              "animation": {
                "inName": "ScaleHandler",
                "loopName": "",
                "outName": "ScaleHandler"
              }
            },
            {
              "id": "optional_gif_badge",
              "type": "gif",
              "startUs": 0,
              "endUs": 3000000,
